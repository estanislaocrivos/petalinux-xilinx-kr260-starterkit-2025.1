# --- PetaLinux build outputs (regenerated by petalinux-build) ---
build/
images/
pre-built/
components/plnx_workspace/
components/yocto/

# --- PetaLinux internal metadata (only metadata is part of the project) ---
.petalinux/*
!.petalinux/metadata

# --- project-spec/configs: backups and intermediates of petalinux-config ---
project-spec/configs/*.old
project-spec/configs/*.pp
project-spec/configs/*.dtb
project-spec/configs/.statistics
project-spec/configs/gen-machineconf.log*

# --- Vivado generated files (sources, .xpr and outputs/*.xsa are kept) ---
hardware/*/*.cache/
hardware/*/*.gen/
hardware/*/*.hw/
hardware/*/*.ip_user_files/
hardware/*/*.runs/
hardware/*/*.sim/
.Xil/
*.jou
*.str
vivado*.backup.*

# --- Misc ---
*.o
*.log
*.bak
*.swp
*~
